# 党建工作智能体 - 单机简化版部署环境变量示例
# 用法：cp deploy/server/env.example .env 并填写实际值（.env 不会被提交到 git）

# ==================== 运行环境 ====================
# development / production。单机简化版（无 TLS）请保持 development；
# ENV=production 会强制要求数据库与 Redis 走 TLS 并校验文件加密密钥环。
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== 安全 ====================
# JWT 签名密钥：至少 32 字符，勿以 dev_/please_change 开头。
# 生成：openssl rand -hex 32
SECRET_KEY=please_change_me_to_a_random_64_hex_characters_000000000

# 允许的访问来源（HTTP Host 头白名单）。公网 IP 访问时填服务器的公网 IP。
# 例：ALLOWED_HOSTS=["123.45.67.89"]   也可以是 ["*"]（不推荐，试用可临时用）
ALLOWED_HOSTS=["*"]

# ==================== 数据库 ====================
POSTGRES_DB=party_agent
POSTGRES_USER=party_user
POSTGRES_PASSWORD=please_change_me_postgres_password

# ==================== 模型（百炼云端接入） ====================
# 阿里云百炼 DashScope API Key。没有时系统可启动但智能问答/向量化不可用。
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen3.8-flash
EMBED_MODEL=qwen3.7-text-embedding-flash
RERANK_MODEL=qwen3.7-text-rerank
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALLOWED_EXTERNAL_MODELS=["dashscope.aliyuncs.com"]
ALLOWED_LOCAL_MODEL_HOSTS=[]

# ==================== 2G 内存瘦身 ====================
# 关闭 Celery 后台 worker，由主进程处理请求（试用验证足够）。
JOB_WORKER_ENABLED=false

# ==================== 镜像源（可选） ====================
# 国内拉取 Docker Hub 镜像失败时改为可用加速源，如 docker.m.daocloud.io。
# 先用 scripts/check-docker-mirrors.sh 自检，只保留判定为「可用」的源。
DOCKERHUB_MIRROR=docker.io