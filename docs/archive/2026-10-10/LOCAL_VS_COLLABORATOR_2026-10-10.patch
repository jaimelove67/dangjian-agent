+    errors = [
+        {"loc": list(error["loc"]), "msg": error["msg"], "type": error["type"]}
+        for error in exc.errors()
+    ]
+    return JSONResponse(
+        status_code=422,
+        content={
+            "code": ErrorCode.PARAM_ERROR,
+            "message": "请求参数校验失败",
+            "data": None,
