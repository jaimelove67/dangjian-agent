# 党建工作智能体 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL 数据库密码
POSTGRES_PASSWORD=your_secure_password_here

# 数据库连接 URL（生产环境）
# DATABASE_URL=postgresql://party_user:password@postgres:5432/party_agent

# ==================== Redis 配置 ====================
# Redis 密码
REDIS_PASSWORD=your_redis_password_here

# Redis 连接 URL（生产环境）
# REDIS_URL=redis://:password@redis:6379/0

# ==================== 应用配置 ====================
# 运行环境：development / production
ENV=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 应用密钥（用于 JWT 签名等，必须修改）
SECRET_KEY=your_secret_key_change_this_in_production

# 允许的主机（生产环境设置具体域名）
ALLOWED_HOSTS=*

# ==================== 模型配置 ====================
# 通义千问 API Key
QWEN_API_KEY=sk-your-qwen-api-key-here

# 本地 Embedding 模型路径
EMBEDDING_MODEL_PATH=/models/bge-large-zh-v1.5

# 本地模型目录（宿主机路径，用于 volume 挂载）
LOCAL_MODEL_PATH=./models

# 重排模型路径
RERANKER_MODEL_PATH=/models/bge-reranker-large

# ==================== 私有化模型配置（可选） ====================
# 本地推理服务地址（如 Ollama、vLLM 等）
# LOCAL_LLM_BASE_URL=http://local-llm:8000
# LOCAL_LLM_MODEL_NAME=qwen2-7b-instruct

# ==================== 安全配置 ====================
# 模型出网白名单（逗号分隔，为空则全部拦截）
# ALLOWED_EXTERNAL_MODELS=dashscope.aliyuncs.com,api.openai.com

# 是否启用敏感数据出网拦截（true/false）
ENABLE_DATA_LEVEL_GATEWAY=true

# ==================== 检索配置 ====================
# 混合检索初检条数
RETRIEVAL_TOP_K=10

# 重排后保留条数
RERANK_TOP_K=5

# 无依据判定阈值
NO_EVIDENCE_THRESHOLD=0.5

# 是否默认排除失效文件
EXCLUDE_EXPIRED_BY_DEFAULT=true

# ==================== 业务配置 ====================
# 入党积极分子培养期上限（天）
ACTIVIST_TRAINING_DAYS=365

# 预备党员预备期上限（天）
PROBATIONARY_PERIOD_DAYS=365

# ==================== 监控配置 ====================
# Prometheus 监控端口
# PROMETHEUS_PORT=9090

# ==================== 第三方集成（可选） ====================
# 企业微信配置
# WECHAT_CORP_ID=your_corp_id
# WECHAT_CORP_SECRET=your_corp_secret

# 邮件配置（用于提醒通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@party-agent.local
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@party-agent.local

# ==================== 开发工具配置 ====================
# pgAdmin 配置（仅开发环境）
PGADMIN_DEFAULT_EMAIL=admin@party-agent.local
PGADMIN_DEFAULT_PASSWORD=admin
