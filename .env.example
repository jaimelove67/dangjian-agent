# 党建工作智能体 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL 数据库密码
POSTGRES_PASSWORD=your_secure_password_here

# 数据库连接 URL（生产环境）
# DATABASE_URL=postgresql+asyncpg://party_user:password@postgres:5432/party_agent

# 本机开发容器端口（docker-compose.dev.yml）
POSTGRES_PORT=55432
# 本机运行后端时，使用上方实际数据库密码填写连接 URL
# DATABASE_URL=postgresql+asyncpg://party_user:password@127.0.0.1:55432/party_agent_dev

# ==================== Redis 配置 ====================
# Redis 密码
REDIS_PASSWORD=your_redis_password_here

# Redis 连接 URL（生产环境）
# REDIS_URL=redis://:password@redis:6379/0

# 本机开发 Redis 端口
REDIS_PORT=56379
# REDIS_URL=redis://127.0.0.1:56379/0

# ==================== 应用配置 ====================
# 运行环境：development / production
ENV=development

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 应用密钥（用于 JWT 签名等，必须修改）
SECRET_KEY=your_secret_key_change_this_in_production

# JWT config
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# 允许的主机（生产环境设置具体域名）
ALLOWED_HOSTS=["*"]

# ==================== 模型配置 ====================
# 三种模型共用已获授权的百炼密钥，无需下载本地模型。
DASHSCOPE_API_KEY=

# LLM 模型配置
CHAT_MODEL=deepseek-v3
EMBED_MODEL=qwen3.7-text-embedding-flash
RERANK_MODEL=qwen3.7-text-rerank
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 三种模型均通过百炼云端接入，向量维度固定为 1024。
# 如控制台要求业务空间专属域名，将下面值改为 https://<业务空间ID>.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
MODEL_TIMEOUT_SECONDS=45

# ==================== 安全配置 ====================
# 内部数据出网白名单（JSON 数组，需组织授权）。敏感与涉密不因白名单而放行。
ALLOWED_EXTERNAL_MODELS=["dashscope.aliyuncs.com"]
# 使用业务空间域名时，改为上面 API Host 的完整主机名。

# 安全边界始终执行；此字段仅保留旧配置兼容。
ENABLE_DATA_LEVEL_GATEWAY=true

# ==================== 检索配置 ====================
# 混合检索初检条数
RETRIEVAL_TOP_K=10

# 重排后保留条数
RERANK_TOP_K=5

# 无依据判定阈值
NO_EVIDENCE_THRESHOLD=0.5

# 是否默认排除失效文件
EXCLUDE_EXPIRED_BY_DEFAULT=true

# ==================== 业务配置 ====================
# 入党积极分子培养期上限（天）
ACTIVIST_TRAINING_DAYS=365

# 预备党员预备期上限（天）
PROBATIONARY_PERIOD_DAYS=365

# 年度考核站内提醒扫描间隔（秒，60–86400；默认每5分钟）。
ASSESSMENT_REMINDER_SCAN_SECONDS=300

# ==================== 监控配置 ====================
# Prometheus 监控端口
# PROMETHEUS_PORT=9090

# ==================== 第三方集成（可选） ====================
# 企业微信配置
# WECHAT_CORP_ID=your_corp_id
# WECHAT_CORP_SECRET=your_corp_secret

# 邮件配置（用于提醒通知）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@party-agent.local
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@party-agent.local

# ==================== 开发工具配置 ====================
# pgAdmin 配置（仅开发环境）
PGADMIN_DEFAULT_EMAIL=admin@party-agent.local
PGADMIN_DEFAULT_PASSWORD=admin

# ==================== 镜像源配置（可选） ====================
# 默认值等价于官方仓库，网络正常时保持默认即可，不要改动。
# 网络受限时再按下方说明覆盖，切勿填未实测的源。
# 先用 scripts/check-docker-mirrors.sh 自检，只保留判定为「可用」的源。

# Docker Hub 加速源前缀（不含协议、不含结尾斜杠）。
# 默认 docker.io；国内可选示例：docker.m.daocloud.io
# 详见 deploy/docker/MIRROR_GUIDE.md
DOCKERHUB_MIRROR=docker.io

# 非 Docker Hub 仓库前缀（ghcr.io 等）。
# registry-mirrors 对 ghcr.io 完全无效，只能直连或用支持该仓库的源。
# 若所在网络无法直连 GHCR，建议改用离线分发：
#   bash scripts/offline-images.sh save   # 联网机器上打包
#   bash scripts/offline-images.sh load   # 目标机器上导入
GHCR_MIRROR=ghcr.io
