# demo: local, clearly labelled example data. live: real FastAPI backend.
VITE_DATA_MODE=demo
VITE_API_TARGET=http://127.0.0.1:8000
# Browser API prefix. Leave relative for the development/reverse proxy.
# For separate origins: https://api.example.edu/api/v1 (allow the frontend origin on the backend).
VITE_API_BASE_URL=/api/v1
