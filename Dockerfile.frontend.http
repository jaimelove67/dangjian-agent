# 党建工作智能体 - 单机简化版前端镜像（HTTP:80）
#
# 与 Dockerfile.frontend（HTTPS 8443）的唯一差异：
#   - 使用 config/nginx-http.conf（listen 80，无 TLS）
#   - nginx 以默认用户运行（root master + nginx worker），无需 tmpfs/证书挂载，
#     适合 2 核 2G 免费试用机快速跑通；正式上线请改用 HTTPS 版。
# 基础镜像经 ARG 注入（与 Dockerfile 的 BASE_IMAGE 约定一致），
# 国内构建时由 compose 传入 DOCKERHUB_MIRROR 前缀，默认等价官方地址。
# 注意：两个 ARG 都必须在第一个 FROM 之前声明（全局作用域）。
ARG NODE_IMAGE=docker.io/library/node:24-alpine
ARG NGINX_IMAGE=docker.io/library/nginx:1.28-alpine
ARG NPM_REGISTRY=https://registry.npmjs.org
FROM ${NODE_IMAGE} AS build
# stage 内重新声明以继承全局 ARG 值
ARG NPM_REGISTRY
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --registry=${NPM_REGISTRY}
COPY frontend/ ./
RUN npm run build

FROM ${NGINX_IMAGE}
COPY config/nginx-http.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/dist /usr/share/nginx/html
EXPOSE 80